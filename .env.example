# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=26214400
MAX_ROWS_PER_JOB=10000
MAX_FETCH_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx

# Persistence: use postgres in GCP; memory is only for local/demo mode.
STORAGE_BACKEND=memory
DATABASE_URL=postgresql+psycopg://forgegraph@/forgegraph?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://localhost:6379/0

# Artifacts: use gcs in GCP; local stores files under .forgegraph-data.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=forgegraph-local
OBJECT_STORAGE_PREFIX=forgegraph
OBJECT_STORAGE_ENDPOINT=
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Job execution: Cloud Tasks is the production mode; inline is for local development.
JOB_EXECUTION_MODE=inline
CLOUD_TASKS_QUEUE=forgegraph-jobs
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_DISPATCH_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
INTERNAL_WORKER_TOKEN=

# AI: Vertex AI is the recommended GCP provider. Keep disabled until credentials and policies are ready.
AI_PROVIDER=disabled
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=60

# Manufacturer evidence policy. Use approved manufacturer domains only.
MANUFACTURER_DOMAINS=
RETRIEVAL_USER_AGENT=ForgeGraphBot/1.0
RETRIEVAL_MAX_REDIRECTS=3

# Authentication. Enable only after configuring an OIDC issuer, audience, and JWKS endpoint.
AUTH_ENABLED=false
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
